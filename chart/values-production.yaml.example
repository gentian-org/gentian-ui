# Production overrides — copy to gentian-deployments; never commit secrets.
# See docs/SECURITY.md (M9, M27).

kernelDomain: example.gentian.cloud

auth:
  disabled: false

api:
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 256Mi
  env:
    ENVIRONMENT: production
    BACKEND_CORS_ORIGINS: https://portal.example.gentian.cloud
    # OIDC_*, DATABASE_URL, OPENFGA_* from existingSecret

web:
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 128Mi
  env:
    # Build-time Vite args — set in CI image build, not at pod runtime
    # (empty — see below)
    # No VITE_* at all: those are build-time constants Vite freezes into the
    # bundle, and one image serves every cluster. Set kernelDomain (and
    # auth.clientId / auth.scopes if they differ) at the top level instead — the
    # web container renders them into /config.js at start.
    #
    # No VITE_OIDC_REDIRECT_URI either: the portal derives it from window.location.origin,
    # since it is served on the shared host and on every tenant's own.

openfga:
  apiUrl: ""
  storeId: ""
  authzenEnabled: true  # requires OpenFGA experimentals: [authzen] in Suze values
