# Local dev — copy to .env (never commit .env)
ENVIRONMENT=local
KERNEL_DOMAIN=localhost
AUTH_DISABLED=true
BACKEND_CORS_ORIGINS=http://localhost:5173
# DATABASE_URL — PostgreSQL for shell persistence (admin audit log, future prefs).
# docker-compose.dev.yaml provisions gentian_shell and sets this automatically.
# DATABASE_URL=postgresql+psycopg://shell:shell@localhost:5433/gentian_shell
# OIDC_ISSUER=https://id.example/auth/realms/kernel
# OIDC_CLIENT_ID=gentian-portal
# KEYCLOAK_ADMIN_URL=http://localhost:8080/auth
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=changeme
# OPENFGA_API_URL=
# OPENFGA_STORE_ID=
