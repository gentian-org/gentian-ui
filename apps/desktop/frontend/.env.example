# Vite build-time vars — copy to .env.local for dev
VITE_AUTH_DISABLED=true
# Keycloak keycloakx chart serves OIDC under /auth/realms/<realm>
# VITE_OIDC_ISSUER=https://id.example.gentian.org/auth/realms/kernel
# VITE_OIDC_CLIENT_ID=gentian-portal
# VITE_OIDC_SCOPES=openid profile email
# No VITE_OIDC_REDIRECT_URI: always this origin's own /login (oidc.ts).
