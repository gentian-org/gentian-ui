# Local dev — copy to .env (never commit .env)
ENVIRONMENT=local
TENANT_ID=demo
AUTH_DISABLED=true
# The Vite proxy rewrites Host to the API's, so the page's origin is named
# here for the origin check (app/core/origin_check.py).
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# The cluster's services, asked with the caller's own token.
# DIRECTOR_URL=http://localhost:8080
# CUSTODIAN_URL=http://localhost:9444
# USHER_URL=http://localhost:8081

# The store's API: https, no trailing slash. Unset, the app says that no App
# Store is configured.
# STORE_URL=https://store.example
# This app's own public host, store.<the tenant's base domain>. A sign-in to a
# store is spelled from it; without it there is none.
# APP_HOST=store.demo.example.org
